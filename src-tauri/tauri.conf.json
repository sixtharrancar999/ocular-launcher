{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ocular Launcher",
  "version": "0.2.1",
  "identifier": "dev.ocular.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ocular Launcher",
        "width": 1280,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QjhCNEZEMDZFMzIwM0UKUldRK0lPTUcvYlM0UktTNzBrYjVER0JMNktNc1Jza2J6bkZydWIxR1Mya2JEczZHNVkveXovODcK",
      "endpoints": [
        "https://github.com/sixtharrancar999/ocular-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
